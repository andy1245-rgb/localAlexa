# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated results: the historical records in results/historical/ stay tracked
results/*
!results/historical/
!results/historical/*.json
!results/ladder/
!results/ladder/*.json
!results/cactus_hybrid_results.json
!results/public/
!results/public/*.json

# Data that is downloaded rather than shipped (CLINC150 / Banking77 / HWU64)
data/raw/

# Model weights
*.gguf
*.onnx
*.safetensors

# Heavy ladder venv (setfit / sentence-transformers), recorded in docs/ladder-env.md
.venv-embed/

# SetFit/transformers scratch output
checkpoints/

# Collected utterances: personal data, never committed
var/

# dell321 overnight results: small JSON plus rendered tables
!results/dell321/
!results/dell321/*.json
!results/dell321/*.md

# The survey evidence is published: every number in the base-model survey must be
# traceable to a file a reader can open.
!results/survey-2026-11-23/
!results/survey-2026-11-23/**
